{
  "contract_version": "catsco.artifact-manifest.v3",
  "purpose": "Review teaching-report rows and compose a bounded UI-document patch with a human or the owning Agent.",
  "views": ["review-table", "summary-panel", "approval-panel", "agent-notes", "ui-builder"],
  "entities": ["lesson-review-row", "agent-review-note", "ui-document-proposal"],
  "entrypoints": ["index.html"],
  "observation_capabilities": ["runtime_snapshot", "semantic_context"],
  "result_sinks": [
    {
      "id": "lesson-report.agent-notes.upsert.v1",
      "description": "Create a bounded Agent review note for the selected report rows.",
      "input_schema": {
        "type": "object",
        "required": ["summary"],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "row_ids": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "recommendations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    {
      "id": "lesson-report.ui-document-patch.propose.v1",
      "description": "Stage a bounded declarative UI-document patch proposal for the current preview; a human applies or discards it.",
      "input_schema": {
        "type": "object",
        "required": ["contract_version", "document_id", "base_revision", "ops"],
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string",
            "enum": ["artifact-ax.ui-document-patch.v1"]
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "ops": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  ],
  "task_intents": [
    {
      "id": "lesson-report.review-selection.v1",
      "title": "Review selected report context",
      "description": "Review the selected report rows and return a bounded note for this application.",
      "input_schema": {
        "type": "object",
        "required": [
          "bundle_id",
          "session_id",
          "actor_id",
          "artifact_id",
          "revision",
          "selections",
          "intent",
          "assessment"
        ],
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "selections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["selection_id", "artifact_id", "revision", "region_id", "label"],
              "additionalProperties": false,
              "properties": {
                "selection_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "artifact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "intent": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "assessment": {
            "type": "object",
            "required": ["intent_kind", "confidence", "risk", "complete"],
            "additionalProperties": false,
            "properties": {
              "intent_kind": {
                "type": "string",
                "enum": ["collect", "inspect", "explain", "review", "compare", "change", "destructive", "ambiguous"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "risk": {
                "type": "string",
                "enum": ["none", "low", "medium", "high"]
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "result_sink": "lesson-report.agent-notes.upsert.v1"
    },
    {
      "id": "lesson-report.compose-ui.v1",
      "title": "Compose a bounded UI-document patch",
      "description": "Propose a validated declarative UI-document patch from the user's bounded UI intent. The page stages it; a human applies or discards it.",
      "input_schema": {
        "type": "object",
        "required": ["intent", "application", "document"],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "application": {
            "type": "object",
            "required": ["artifact_id", "revision"],
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "actor_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "document": {
            "type": "object",
            "required": ["contract_version", "id", "revision"],
            "additionalProperties": false,
            "properties": {
              "contract_version": {
                "type": "string",
                "enum": ["artifact-ax.ui-document.v1"]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "nodes": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "result_sink": "lesson-report.ui-document-patch.propose.v1"
    }
  ]
}
