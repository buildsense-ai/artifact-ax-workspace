{
  "contract_version": "catsco.artifact-manifest.v4",
  "purpose": "Collaboratively review teaching-report rows: shared findings, feedback, agent-revised comparisons, and a semantic activity journal.",
  "views": ["review-table", "workboard", "comparison-views", "journal"],
  "entities": ["lesson-review-row", "work-item", "finding", "finding-feedback", "comparison-view", "agent-note"],
  "entrypoints": ["index.html"],
  "observation_capabilities": ["runtime_state", "semantic_context"],
  "runtime": {
    "version": "0.2",
    "surfaces": [
      { "id": "report", "title": "Review table" },
      { "id": "workboard", "title": "Work items and findings" },
      { "id": "journal", "title": "Activity journal" }
    ],
    "state": [
      { "namespace": "shared", "mode": "read-write" },
      { "namespace": "presence", "mode": "read-write" },
      { "namespace": "semantic", "mode": "read-write" },
      { "namespace": "journal", "mode": "read-write" },
      { "namespace": "result", "mode": "read-write" },
      { "namespace": "agent", "mode": "read-write" }
    ]
  },
  "result_sinks": [
    {
      "id": "lesson-report.agent-notes.upsert.v1",
      "description": "Create a bounded Agent review note for the selected report rows.",
      "input_schema": {
        "type": "object",
        "required": ["summary"],
        "additionalProperties": false,
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "row_ids": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    }
  ],
  "task_intents": [
    {
      "id": "lesson-report.collab-review.v1",
      "title": "Review a shared finding",
      "description": "Revise exactly one finding in a shared work item and stage one comparison view. Completes by writing a Runtime State result document; a person must explicitly Use or Discard the staged view.",
      "input_schema": {
        "type": "object",
        "required": ["contract_version", "room", "work_item", "finding"],
        "additionalProperties": false,
        "properties": {
          "contract_version": { "type": "string", "enum": ["lesson-report.collaboration-task.v2"] },
          "room": { "type": "string", "minLength": 1, "maxLength": 64 },
          "work_item": { "type": "object" },
          "finding": { "type": "object" },
          "input_preparation": { "type": "object" }
        }
      },
      "completion": { "mode": "runtime_state" }
    },
    {
      "id": "lesson-report.judge-view.v1",
      "title": "Judge a staged comparison view",
      "description": "JEV judge: evaluate whether an agent-authored UiDocument staged under a proposal matches intent and context, and write a typed verdict document (allow | flag | abstain). The verdict is supplementary evidence — the human Use/Discard remains the authorization path.",
      "input_schema": {
        "type": "object",
        "required": ["contract_version", "room", "proposal"],
        "additionalProperties": false,
        "properties": {
          "contract_version": { "type": "string", "enum": ["lesson-report.judge-task.v1"] },
          "room": { "type": "string", "minLength": 1, "maxLength": 64 },
          "proposal": { "type": "object" }
        }
      },
      "completion": { "mode": "runtime_state" }
    },
    {
      "id": "lesson-report.annotate-ask.v1",
      "title": "Ask about an annotated element",
      "description": "A human anchored a note to a rendered element and asked the agent about it. Embedded, the task lands in chat as an artifact reference; standalone, the colleague answers via the agent namespace. The annotation entity is shared room state; the agent answers with a note and journal entry.",
      "input_schema": {
        "type": "object",
        "required": ["contract_version", "room", "annotation"],
        "additionalProperties": false,
        "properties": {
          "contract_version": { "type": "string", "enum": ["lesson-report.annotate-task.v1"] },
          "room": { "type": "string", "minLength": 1, "maxLength": 64 },
          "annotation": { "type": "object" }
        }
      },
      "completion": { "mode": "runtime_state" }
    },
    {
      "id": "lesson-report.review-selection.v1",
      "title": "Review selected rows",
      "description": "Review the selected report rows and write a bounded Agent note to the declared result sink.",
      "input_schema": {
        "type": "object",
        "required": ["row_ids"],
        "additionalProperties": false,
        "properties": {
          "row_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      },
      "result_sink": "lesson-report.agent-notes.upsert.v1"
    }
  ]
}
